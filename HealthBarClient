--[[
	HealthBarClient
	- This script runs on the player's client.
	- It finds the player's character and humanoid.
	- It connects to the .HealthChanged and .MaxHealth.Changed events.
	- It updates the health bar text and size automatically.
]]

-- --- SERVICES ---
local Players = game:GetService("Players")

-- --- GUI OBJECTS ---
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local HealthBarGui = playerGui:WaitForChild("PlayerHealthGui")
local HealthBarFrame = HealthBarGui:WaitForChild("HealthBarFrame")
local BarForeground = HealthBarFrame:WaitForChild("BarBackground"):WaitForChild("BarForeground")
local HealthText = HealthBarFrame:WaitForChild("HealthText")

-- --- FUNCTION TO UPDATE THE GUI ---
local function updateHealthBar(humanoid)
	local currentHealth = math.floor(humanoid.Health)
	local maxHealth = math.floor(humanoid.MaxHealth)

	-- Update the text label
	HealthText.Text = currentHealth .. " / " .. maxHealth

	-- Update the bar size
	local percent = currentHealth / maxHealth
	BarForeground.Size = UDim2.new(percent, 0, 1, 0)
end

-- --- FUNCTION TO SET UP A NEW CHARACTER ---
local function onCharacterAdded(character)
	local humanoid = character:WaitForChild("Humanoid")

	-- 1. Set the initial health on spawn
	updateHealthBar(humanoid)

	-- 2. Listen for health changes (damage, healing)
	humanoid.HealthChanged:Connect(function()
		updateHealthBar(humanoid)
	end)

	-- 3. Listen for MAX health changes (from upgrades)
	humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
		updateHealthBar(humanoid)
	end)
end

-- --- INITIALIZATION ---
-- Connect the function to the player's CharacterAdded event
player.CharacterAdded:Connect(onCharacterAdded)

-- Run the function once for the character that might already exist
if player.Character then
	onCharacterAdded(player.Character)
end

print("HealthBarClient loaded.")
