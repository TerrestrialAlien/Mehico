--[[
	ZoneVisualsClient.lua (v1.15 - FINAL "BaseColor" Fix)
	- This is a new LocalScript, place it in StarterPlayer > StarterPlayerScripts
	- Listens for the game to start in "ZoneControl" mode.
	- Waits for the first `onUpdateZoneUI` event before finding map parts.
	- This 100% fixes the "Could not find CurrentMap" race condition.
	- FIX: Rings now ONLY rise when one team controls BOTH poles.
	- FIX: BasePlatform and BaseZone ONLY change color when BOTH poles are captured.
	- Creates a gentle "bobbing" animation for the rings when active.
	- NEW LOGIC: Script now uses the ring's *editor position* as the "Risen" CFrame
	-            and calculates the "Hidden" CFrame 20 studs below the BasePlatform.
	- NEW LOGIC: Rings are now snapped to their "Hidden" position on init.
]]

-- --- SERVICES ---
local Players = game:GetService("Players")
local ReplicatedStorage = game:WaitForChild("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Teams = game:GetService("Teams")
local RunService = game:GetService("RunService")

-- --- EVENTS ---
local eventFolder = ReplicatedStorage:WaitForChild("GameEvents")
local updateGameMode = eventFolder:WaitForChild("UpdateGameMode")
local updateZoneControlUI = eventFolder:WaitForChild("UpdateZoneControlUI")
local updateGameStateEvent = eventFolder:WaitForChild("UpdateGameState") -- NEW: For cleanup

-- --- TEAMS ---
local blueTeam = Teams["Bright blue"]
local pinkTeam = Teams["Carnation pink"]

-- --- LOCAL CACHE ---
local isInitialized = false -- NEW: Tracks if we've found the map parts yet
local currentGamemode = ""
local zoneBase = nil
local zoneRing = nil -- NEW: For the static BaseZone ring
local rings = {} -- Stores { part, originalCFrame, risenCFrame }
local bobTweens = {} -- Stores active bobbing tweens
local activeRiseTweens = {} -- FIX: Store active tweens

-- --- TWEEN INFO ---
local TWEEN_RISE = TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_SINK = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local HIDDEN_OFFSET = 20 -- Studs to hide *below* the base platform

-- ===================================================================
-- ANIMATION FUNCTIONS
-- ===================================================================

-- Stops all active bobbing animations
local function stopBobbingAnimations()
	for _, tween in pairs(bobTweens) do
		tween:Cancel()
	end
	bobTweens = {}
end

-- Stops all active rise/sink animations
local function stopRiseAnimations()
	for _, tween in pairs(activeRiseTweens) do
		tween:Cancel()
	end
	activeRiseTweens = {}
end

-- Starts the gentle up-and-down bobbing for all rings
local function startBobbingAnimations()
	stopBobbingAnimations() -- Stop any old ones first

	for _, ringData in ipairs(rings) do
		local part = ringData.part
		local risenCFrame = ringData.risenCFrame

		-- Create an independent bobbing animation for each ring
		local bobUp = risenCFrame * CFrame.new(0, 1, 0)

		-- Use a random delay to make them move independently
		task.wait(math.random() * 0.5) 

		local TWEEN_BOB = TweenInfo.new(
			2.0 + (math.random() * 1.0), -- Give each a slightly different speed
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1, -- Loop forever
			true -- Reverse
		)

		local tweenUp = TweenService:Create(part, TWEEN_BOB, { CFrame = bobUp })

		-- Store and play
		bobTweens[part] = tweenUp
		tweenUp:Play()
	end
end

-- Main function to animate the rings rising or sinking
-- *** THIS IS THE FIX (Part A) ***
-- It now accepts a "baseColor" so it knows what color to make the base when hiding
local function animateRings(targetState, team, baseColor)
	stopRiseAnimations() -- Cancel any currently running tweens
	stopBobbingAnimations()

	local ringColor = Color3.new(1, 1, 1) -- Default to white
	if team == blueTeam then
		ringColor = blueTeam.TeamColor.Color
	elseif team == pinkTeam then
		ringColor = pinkTeam.TeamColor.Color
	end

	if targetState == "Risen" then
		print("[ZoneVisuals] Rings rising!")
		for _, ringData in ipairs(rings) do
			local part = ringData.part
			-- Rise animation
			part.Color = ringColor
			local riseTween = TweenService:Create(part, TWEEN_RISE, { CFrame = ringData.risenCFrame })
			table.insert(activeRiseTweens, riseTween) -- Store the tween
			riseTween:Play()
		end
		-- After they rise, start bobbing
		task.wait(TWEEN_RISE.Time)
		startBobbingAnimations()

		-- Color the base
		if zoneBase then
			TweenService:Create(zoneBase, TWEEN_RISE, { Color = ringColor }):Play()
		end
		-- NEW: Color the static ring
		if zoneRing then
			TweenService:Create(zoneRing, TWEEN_RISE, { Color = ringColor }):Play()
		end

	elseif targetState == "Hidden" then
		print("[ZoneVisuals] Rings sinking!")
		for _, ringData in ipairs(rings) do
			local part = ringData.part
			-- Sink animation
			local sinkTween = TweenService:Create(part, TWEEN_SINK, { CFrame = ringData.originalCFrame })
			table.insert(activeRiseTweens, sinkTween) -- Store the tween
			sinkTween:Play()
		end

		-- After they sink, reset color
		task.wait(TWEEN_SINK.Time)
		for _, ringData in ipairs(rings) do
			ringData.part.Color = ringColor -- This will be white
		end

		-- *** THIS IS THE FIX (Part B) ***
		-- Color the base with the new "baseColor" parameter
		if zoneBase then
			TweenService:Create(zoneBase, TWEEN_SINK, { Color = baseColor }):Play()
		end
		-- NEW: Color the static ring
		if zoneRing then
			TweenService:Create(zoneRing, TWEEN_SINK, { Color = baseColor }):Play()
		end
	end
end


-- ===================================================================
-- EVENT LISTENERS
-- ===================================================================

-- Called when the gamemode is chosen
local function onUpdateGameMode(gamemode)
	-- Store the gamemode
	currentGamemode = gamemode

	-- Clear all old data
	stopBobbingAnimations()
	stopRiseAnimations()
	rings = {}
	zoneBase = nil
	zoneRing = nil
	isInitialized = false -- Reset for the next round!

	if gamemode == "Intermission" then
		animateRings("Hidden", nil, Color3.new(1,1,1))
	end
end

-- Called when a pole is captured
local function onUpdateZoneUI(pole1, pole1Owner, pole2, pole2Owner)
	-- *** THIS IS THE FIX ***
	-- If this is the first event of the round, find all the parts!
	if not isInitialized and currentGamemode == "ZoneControl" and pole1 then

		-- Find the map by finding the pole's ancestor
		local map = pole1:FindFirstAncestor("CurrentMap")
		if not map then
			warn("ZoneVisualsClient: Could not find CurrentMap from pole!")
			return
		end

		local visuals = map:FindFirstChild("ZoneVisuals")
		if not visuals then
			warn("ZoneVisualsClient: Map has no ZoneVisuals model!")
			return
		end

		zoneBase = visuals:FindFirstChild("BasePlatform")
		zoneRing = visuals:FindFirstChild("BaseZone") -- NEW: Find the static ring
		local ringsFolder = visuals:FindFirstChild("Rings")

		if not ringsFolder then
			warn("ZoneVisualsClient: ZoneVisuals model has no Rings folder!")
			return
		end

		-- *** THIS IS THE NEW FIX (v1.14) ***
		-- We need the BasePlatform's Y-position to calculate the hidden position
		local basePlatformY = 0
		if zoneBase then
			basePlatformY = zoneBase.Position.Y
		else
			warn("ZoneVisualsClient: No BasePlatform found! Rings will hide at Y=-20.")
		end

		-- Store the start and end positions for all rings
		for _, part in ipairs(ringsFolder:GetChildren()) do
			if part:IsA("BasePart") then

				-- Store Risen CFrame (where it is in the editor)
				local risenCFrame = part.CFrame

				-- Get ALL components to preserve rotation
				local x, y, z, R00, R01, R02, R10, R11, R12, R20, R21, R22 = risenCFrame:GetComponents()

				-- Calculate "Hidden" CFrame (20 studs below platform, with original rotation)
				local hiddenCFrame = CFrame.new(x, basePlatformY - HIDDEN_OFFSET, z) * CFrame.new(0,0,0, R00, R01, R02, R10, R11, R12, R20, R21, R22)

				-- *** DEBUG PRINT ***
				print("Ring: " .. part.Name .. " | Risen Y: " .. string.format("%.2f", y) .. " | Hidden Y: " .. string.format("%.2f", hiddenCFrame.Position.Y))

				table.insert(rings, {
					part = part,
					originalCFrame = hiddenCFrame, -- This is the "hidden" CFrame
					risenCFrame = risenCFrame -- This is the "risen" CFrame (from editor)
				})

				-- *** SNAP TO HIDDEN POSITION ***
				part.CFrame = hiddenCFrame
			end
		end
		print("[ZoneVisualsClient] Found " .. #rings .. " rings. Ready to animate.")
		isInitialized = true
	end

	-- Now that we have the parts, run the animation logic
	if #rings == 0 and not zoneBase and not zoneRing then return end -- Nothing to animate

	local baseTargetColor = Color3.new(1, 1, 1) -- Default white
	local ringsTargetState = "Hidden" -- Default hidden
	local ringsTargetTeam = nil -- Default neutral

	-- *** THIS IS THE FIX ***
	-- Only when *both* poles are owned by the same team do the rings rise AND the base change color
	if pole1Owner and pole1Owner == pole2Owner then
		-- ONE TEAM HAS BOTH!
		baseTargetColor = pole1Owner.TeamColor.Color
		ringsTargetState = "Risen" -- Rise!
		ringsTargetTeam = pole1Owner -- Color the rings and base

		-- This block now ONLY sets the baseTargetColor for the *sinking* animation
	elseif pole1Owner or pole2Owner then
		-- CONTESTED (or one pole is neutral)
		ringsTargetState = "Hidden"
		ringsTargetTeam = nil

		if pole1Owner and not pole2Owner then
			baseTargetColor = pole1Owner.TeamColor.Color -- One pole is blue
		elseif pole2Owner and not pole1Owner then
			baseTargetColor = pole2Owner.TeamColor.Color -- One pole is pink
		else
			-- Contested (blue and pink), so set to white
			baseTargetColor = Color3.new(1, 1, 1)
		end

	else
		-- Zone is NEUTRAL (both nil)
		ringsTargetState = "Hidden" -- Hide and set color to white
		baseTargetColor = Color3.new(1, 1, 1)
		ringsTargetTeam = nil
	end

	-- Run the ring animation (will either rise or sink)
	-- Pass the baseTargetColor to the function
	animateRings(ringsTargetState, ringsTargetTeam, baseTargetColor)
end

-- Called when the round ends
local function onUpdateGameState(state, status)
	if state == "Intermission" or state == "RoundEnd" then
		-- Hide the rings
		animateRings("Hidden", nil, Color3.new(1,1,1))
		isInitialized = false -- Reset for the next round!
	end
end

-- ===================================================================
-- INITIALIZATION
-- ===================================================================

updateGameMode.OnClientEvent:Connect(onUpdateGameMode)
updateZoneControlUI.OnClientEvent:Connect(onUpdateZoneUI)
updateGameStateEvent.OnClientEvent:Connect(onUpdateGameState)

print("ZoneVisualsClient.lua (v1.15 - BaseColor Fix) loaded.")
