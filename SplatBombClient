--[[
	SplatBombClient.lua (v1.5 - Mobile Image Overlay)
	- Handles client input (R key / Mobile Floating Button).
	- Manages "Aim Mode" (Visual Marker, Camera Rotation).
	- Pitch-Based Aiming for Power.
	- Mobile button follows finger anywhere on screen while aiming.
	- Button snaps back to original position on release.
	- FIX: Added 'ResetOnSpawn = false' to PC UI so it doesn't disappear after death.
	- FIX: Moved PC Cancel Label to the right side to avoid UI overlap.
	- NEW: Unified Cooldown UI (Recharging Bar) for both PC and Mobile.
	- NEW: Added slot for Custom Mobile Button Image Overlay.
]]

-- --- SERVICES ---
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local Workspace = workspace
local GuiService = game:GetService("GuiService")
local StarterGui = game:GetService("StarterGui")

-- --- EVENTS ---
local splatEvents = ReplicatedStorage:WaitForChild("SplatEvents")
local requestThrowEvent = splatEvents:WaitForChild("RequestThrowBomb")
local gameEvents = ReplicatedStorage:WaitForChild("GameEvents")
local updateGameStateEvent = gameEvents:WaitForChild("UpdateGameState")

-- --- PLAYER ---
local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local mouse = player:GetMouse()

-- --- CONFIGURATION ---
local THROW_KEY = Enum.KeyCode.R
local MAX_THROW_DIST = 60 
local MIN_THROW_DIST = 10  
local THROW_ACTION_NAME = "ThrowSplatBomb"
local IS_MOBILE = UserInputService.TouchEnabled
local COOLDOWN_TIME = 12

-- Aim Sensitivity Config
local PITCH_LOOK_DOWN = -0.6 
local PITCH_LOOK_UP = 0.2    
local TOUCH_SENSITIVITY = Vector2.new(0.005, 0.003) 

-- --- STATE ---
local isAiming = false
local aimMarker = nil 
local currentPower = 0
local currentAimCFrame = CFrame.new()
local currentGameState = "Intermission"
local lastThrowTime = 0
local lastEquippedTool = nil

-- Mobile State
local mobileGui = nil
local throwButton = nil
local cancelButton = nil
local touchObject = nil 
local startTouchPos = Vector2.new(0,0)
local originalButtonPos = UDim2.new(0.8, 0, 0.65, 0) 

-- PC State
local pcCancelLabel = nil

-- Shared UI State
local cooldownContainer = nil -- Background
local cooldownBar = nil -- Foreground Bar

-- ===================================================================
-- STATE MANAGEMENT
-- ===================================================================

updateGameStateEvent.OnClientEvent:Connect(function(state)
	currentGameState = state
end)

local function canThrow()
	if currentGameState == "Intermission" then return false end
	if tick() - lastThrowTime < COOLDOWN_TIME then return false end
	local char = player.Character
	if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return false end
	return true
end

-- ===================================================================
-- WEAPON HANDLING
-- ===================================================================

local function stashWeapon()
	local char = player.Character
	if not char then return end
	local humanoid = char:FindFirstChild("Humanoid")
	if not humanoid then return end

	-- Save current tool
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then
		lastEquippedTool = tool
		humanoid:UnequipTools()
	else
		lastEquippedTool = nil
	end

	-- Hide backpack
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end

local function restoreWeapon()
	local char = player.Character
	if not char then return end
	local humanoid = char:FindFirstChild("Humanoid")

	-- Show backpack
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)

	-- Re-equip tool if we had one
	if lastEquippedTool and lastEquippedTool.Parent == player.Backpack and humanoid then
		humanoid:EquipTool(lastEquippedTool)
	end
	lastEquippedTool = nil
end

-- ===================================================================
-- COOLDOWN UI
-- ===================================================================

local function startCooldownVisuals()
	lastThrowTime = tick()

	if cooldownContainer and cooldownBar then
		cooldownContainer.Visible = true
		cooldownBar.Size = UDim2.new(1, 0, 1, 0) -- Start Full

		-- Tween width to 0
		local t = TweenService:Create(cooldownBar, TweenInfo.new(COOLDOWN_TIME, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 1, 0)})
		t:Play()
		t.Completed:Connect(function() cooldownContainer.Visible = false end)
	end
end

-- ===================================================================
-- VISUALS HELPER
-- ===================================================================

local function createAimMarker()
	if aimMarker then aimMarker:Destroy() end

	local part = Instance.new("Part")
	part.Name = "AimMarker"
	part.Size = Vector3.new(4, 0.2, 4)
	part.Shape = Enum.PartType.Cylinder
	part.Transparency = 0.5
	part.Material = Enum.Material.Neon
	part.BrickColor = BrickColor.new("Really red")
	part.Anchored = true
	part.CanCollide = false
	part.CastShadow = false
	part.Parent = Workspace
	return part
end

-- ===================================================================
-- CORE AIMING LOGIC
-- ===================================================================

local function updateAiming()
	if not isAiming then return end

	-- Enforce Mouse Lock (PC Only)
	if not IS_MOBILE then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	end

	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local root = char.HumanoidRootPart

	-- 1. Calculate Power based on Camera Pitch
	local lookVector = camera.CFrame.LookVector
	local pitch = lookVector.Y 

	local alpha = (pitch - PITCH_LOOK_DOWN) / (PITCH_LOOK_UP - PITCH_LOOK_DOWN)
	currentPower = math.clamp(alpha, 0, 1)

	local targetDistance = MIN_THROW_DIST + (currentPower * (MAX_THROW_DIST - MIN_THROW_DIST))

	-- 2. Calculate Goal Position
	local flatLookDir = Vector3.new(lookVector.X, 0, lookVector.Z).Unit

	-- 3. Wall Occlusion Check
	local rayOrigin = root.Position
	local rayDir = flatLookDir * targetDistance
	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {char, aimMarker}
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local wallHit = Workspace:Raycast(rayOrigin, rayDir, rayParams)

	local finalFlatPos
	if wallHit then
		finalFlatPos = wallHit.Position
		local actualDist = (wallHit.Position - root.Position).Magnitude
		currentPower = math.clamp((actualDist - MIN_THROW_DIST) / (MAX_THROW_DIST - MIN_THROW_DIST), 0, 1)
	else
		finalFlatPos = rayOrigin + rayDir
	end

	-- 4. Floor Snap
	local floorRayOrigin = finalFlatPos + Vector3.new(0, 10, 0) 
	local floorRayDir = Vector3.new(0, -50, 0) 
	local floorHit = Workspace:Raycast(floorRayOrigin, floorRayDir, rayParams)

	local markerPos
	if floorHit then
		markerPos = floorHit.Position
	else
		markerPos = Vector3.new(finalFlatPos.X, root.Position.Y - 2.5, finalFlatPos.Z)
	end

	-- 5. Update Visuals
	if aimMarker then
		aimMarker.CFrame = CFrame.new(markerPos) * CFrame.Angles(0,0, math.rad(90)) + Vector3.new(0, 0.2, 0)
	end

	-- 6. Rotate Character
	local lookAtPos = root.Position + flatLookDir * 10
	root.CFrame = CFrame.lookAt(root.Position, Vector3.new(lookAtPos.X, root.Position.Y, lookAtPos.Z))

	currentAimCFrame = camera.CFrame
end

-- ===================================================================
-- START / STOP / CANCEL LOGIC
-- ===================================================================

local function startThrow()
	if isAiming or not canThrow() then return end
	isAiming = true

	stashWeapon()

	-- Create visual
	aimMarker = createAimMarker()

	-- Prepare character
	local char = player.Character
	if char and char:FindFirstChild("Humanoid") then
		char.Humanoid.AutoRotate = false 
	end

	-- Show PC Cancel UI
	if not IS_MOBILE and pcCancelLabel then
		pcCancelLabel.Visible = true
	end

	-- Bind loop
	RunService:BindToRenderStep("SplatAim", Enum.RenderPriority.Camera.Value + 1, updateAiming)
end

local function cancelThrow()
	if not isAiming then return end
	isAiming = false

	-- Reset everything
	pcall(function() RunService:UnbindFromRenderStep("SplatAim") end)

	if not IS_MOBILE then UserInputService.MouseBehavior = Enum.MouseBehavior.Default end
	if aimMarker then aimMarker:Destroy() aimMarker = nil end

	local char = player.Character
	if char and char:FindFirstChild("Humanoid") then
		char.Humanoid.AutoRotate = true
	end

	if not IS_MOBILE and pcCancelLabel then pcCancelLabel.Visible = false end
	if IS_MOBILE and throwButton then throwButton:TweenPosition(originalButtonPos, "Out", "Back", 0.3) end

	restoreWeapon() 
	print("🚫 Bomb Throw Cancelled")
end

local function releaseThrow()
	if not isAiming then return end
	isAiming = false

	pcall(function() RunService:UnbindFromRenderStep("SplatAim") end)

	if not IS_MOBILE then UserInputService.MouseBehavior = Enum.MouseBehavior.Default end
	if aimMarker then aimMarker:Destroy() aimMarker = nil end

	local char = player.Character
	if char and char:FindFirstChild("Humanoid") then
		char.Humanoid.AutoRotate = true
	end

	if not IS_MOBILE and pcCancelLabel then pcCancelLabel.Visible = false end

	-- FIRE!
	requestThrowEvent:FireServer(currentAimCFrame, currentPower)
	startCooldownVisuals()
	restoreWeapon()
end

-- ===================================================================
-- PC INPUT HANDLER
-- ===================================================================

local function pcInputHandler(actionName, inputState, inputObject)
	if IS_MOBILE then return end 

	if inputState == Enum.UserInputState.Begin then
		startThrow()
	elseif inputState == Enum.UserInputState.End then
		releaseThrow()
	end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	-- Check for Left Click Cancel on PC
	if not IS_MOBILE and isAiming and input.UserInputType == Enum.UserInputType.MouseButton1 then
		cancelThrow()
	end
end)

