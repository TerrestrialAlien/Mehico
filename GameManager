setGameState = function(state, winner)  
	print("State: " .. state) 
	currentGameState = state  
	if state == "Intermission" then  
		if currentMap then currentMap:Destroy() currentMap = nil end 
		resetGameData()  
		workspace.Gravity = BASE_GRAVITY 
		intermissionTimer = GAME_INTERMISSION_TIME  
		currentStatus = "Intermission - Waiting for players..."  
		updateGameStateEvent:FireAllClients(state, currentStatus)  
		updateTimerEvent:FireAllClients(intermissionTimer)  
		updateProgressEvent:FireAllClients(0, 0, TF_TOTAL_HACK_POINTS)  
		updateGameMode:FireAllClients("Intermission") 
		updateTeamRosterEvent:FireAllClients(nil) 
		for _, player in ipairs(Players:GetPlayers()) do  
			player.Team = nil  
			removeLoadout(player)  
			if player.Character then player:LoadCharacter() end 
		end  
		intermissionStartedEvent:Fire()  
	elseif state == "RoundInProgress" then  
		local tfMaps = terminalFrenzyMaps:GetChildren()  
		local zcMaps = zoneControlMaps:GetChildren()  
		local modeRng = math.random(1, 2) 
		if (modeRng == 1 and #tfMaps > 0) or #zcMaps == 0 then 
			currentGamemode = "TerminalFrenzy"  
			currentMap = tfMaps[math.random(1, #tfMaps)]:Clone() 
		else  
			currentGamemode = "ZoneControl" 
			currentMap = zcMaps[math.random(1, #zcMaps)]:Clone() 
		end  
		currentMap.Parent = workspace  
		currentMap.Name = "CurrentMap" 
		updateGameMode:FireAllClients(currentGamemode)  
		roundTimer = GAME_ROUND_TIME 
		currentMap.Terminals.BlueTerminals.BlueSpawn.Enabled = true 
		currentMap.Terminals.PinkTerminals.PinkSpawn.Enabled = true 
		local players = Players:GetPlayers()  
		for i = #players, 2, -1 do local j = math.random(i) players[i], players[j] = players[j], players[i] end 
		local rosters = { [blueTeam.Name] = {}, [pinkTeam.Name] = {} } 
		local bCount, pCount = 0, 0 
		for _, player in ipairs(players) do  
			if bCount <= pCount then 
				player.Team = blueTeam; bCount += 1 
				table.insert(rosters[blueTeam.Name], {Name = player.Name, UserId = player.UserId})  
			else  
				player.Team = pinkTeam; pCount += 1 
				table.insert(rosters[pinkTeam.Name], {Name = player.Name, UserId = player.UserId})  
			end  
			giveLoadout(player) 
			player:LoadCharacter() 
		end  
		if currentGamemode == "TerminalFrenzy" then  
			-- Store Bindings 
			local function bindStore(tName, tObj) 
				local f = currentMap.UpgradeStores:FindFirstChild(tName) 
				if f then for _, p in ipairs(f:GetChildren()) do 
						local pp = p:FindFirstChildWhichIsA("ProximityPrompt", true) 
						if pp then pp.Enabled = true; table.insert(zc_poleConnections, pp.Triggered:Connect(function(pl) onUpgradeTriggered(pl, tObj) end)) end 
					end end 
			end 
			bindStore("PinkStore", pinkTeam) 
			bindStore("BlueStore", blueTeam) 

			-- Terminals Bindings 
			local function bindTerms(fName, tHack) 
				local f = currentMap.Terminals:FindFirstChild(fName) 
				if f then for _, p in ipairs(f:GetChildren()) do 
						if (p:IsA("BasePart") or p:IsA("Model")) and not p:IsA("SpawnLocation") then 
							local pp = p:FindFirstChildWhichIsA("ProximityPrompt", true) 
							if pp then 
								pp.Enabled = true 
								table.insert(zc_poleConnections, pp.PromptButtonHoldBegan:Connect(function(pl) tf_onHackStarted(pl, p, tHack) end)) 
								table.insert(zc_poleConnections, pp.PromptButtonHoldEnded:Connect(function(pl) tf_onHackEnded(pl) end)) 
							end 
						end 
					end end 
			end 
			bindTerms("PinkTerminals", pinkTeam) 
			bindTerms("BlueTerminals", blueTeam) 
			tf_updateTerminalHoldDurations(blueTeam) 
			tf_updateTerminalHoldDurations(pinkTeam) 
		else  
			setupZoneControl()  
		end 
		updateGameStateEvent:FireAllClients(state, currentStatus)  
		updateTimerEvent:FireAllClients(roundTimer)  
		updateTeamRosterEvent:FireAllClients(rosters) 
	elseif state == "RoundEnd" then  
		local winStatus = winner and (winner.Name .. " wins!") or "Round Draw!"  
		currentStatus = "Round Over! " .. winStatus  
		updateGameStateEvent:FireAllClients(state, currentStatus)  
		if currentMap then  
			currentMap.Terminals.BlueTerminals.BlueSpawn.Enabled = false  
			currentMap.Terminals.PinkTerminals.PinkSpawn.Enabled = false  
		end  
		tf_playersHacking = {}  
		tf_playerHackData = {}  
		task.delay(5, function() setGameState("Intermission") end) 
	end  
end  

-- FIX: Moved setupZoneControl here to avoid nil call 
setupZoneControl = function() 
	currentStatus = "Capture the Poles!" 

	zc_pole1 = currentMap.ZonePoles:WaitForChild("Pole1") 
	zc_pole2 = currentMap.ZonePoles:WaitForChild("Pole2") 

	local p1 = zc_pole1:FindFirstChildWhichIsA("ProximityPrompt") 
	local p2 = zc_pole2:FindFirstChildWhichIsA("ProximityPrompt") 

	p1.HoldDuration = ZC_CAPTURE_TIME 
	p2.HoldDuration = ZC_CAPTURE_TIME 

	table.insert(zc_poleConnections, p1.Triggered:Connect(function(p) zc_onPoleCaptured(p, 1) end)) 
	table.insert(zc_poleConnections, p2.Triggered:Connect(function(p) zc_onPoleCaptured(p, 2) end)) 

	zc_zone = currentMap:FindFirstChild("Zone") 
	if not zc_zone then warn("Zone part missing!") end 

	-- FIX: Find Fog Emitter 
	local fogPart = currentMap:FindFirstChild("Fog") 
	if fogPart then 
		zc_fogEmitter = fogPart:FindFirstChildWhichIsA("ParticleEmitter", true) 
		if zc_fogEmitter then zc_fogEmitter.Enabled = false end 
		print("Fog Emitter Found: " .. tostring(zc_fogEmitter))  
	else 
		warn("Fog part not found in map")  
		zc_fogEmitter = nil 
	end 

	updateZoneControlUI:FireAllClients(zc_pole1, nil, zc_pole2, nil) 
	updateZoneCountdown:FireAllClients(0, 0, ZC_TARGET_POINTS) 
	updateZoneEffect:FireAllClients(nil) 
end 

onGameTick = function() -- ASSIGNMENT (Matches Forward Decl) 
	if currentGameState == "Intermission" then  
		intermissionTimer = intermissionTimer - 1 
		updateTimerEvent:FireAllClients(intermissionTimer)  

		if intermissionTimer <= 0 then  
			if #Players:GetPlayers() >= MIN_PLAYERS_TO_START then  
				setGameState("RoundInProgress")  
			else  
				intermissionTimer = 5  
				updateGameStateEvent:FireAllClients("Intermission", "Waiting for players...")  
			end  
		end  

	elseif currentGameState == "RoundInProgress" then  
		roundTimer = roundTimer - 1 
		updateTimerEvent:FireAllClients(roundTimer)  

		-- Passive Points 
		for _, player in ipairs(Players:GetPlayers()) do  
			local data = playerData[player.UserId]  
			if data then  
				data.PassiveTimer = data.PassiveTimer + 1  
				if data.PassiveTimer >= PASSIVE_POINT_RATE then  
					data.PassiveTimer = 0  
					data.Points = data.Points + 1  
					updatePointsEvent:FireClient(player, data.Points)  
				end  
			end  
		end  

		if roundTimer <= 0 then  
			-- Overtime / Time End 
			local winner = nil 
			if currentGamemode == "TerminalFrenzy" then 
				if tf_pinkTeamProgress > tf_blueTeamProgress then winner = blueTeam 
				elseif tf_blueTeamProgress > tf_pinkTeamProgress then winner = pinkTeam end 
			elseif currentGamemode == "ZoneControl" then 
				if zc_blueProgress > zc_pinkProgress then winner = blueTeam 
				elseif zc_pinkProgress > zc_blueProgress then winner = pinkTeam end 
			end 
			setGameState("RoundEnd", winner) 
		end  

		-- Proximity Highlight (TF only) 
		if currentGamemode == "TerminalFrenzy" then  
			for _, player in ipairs(Players:GetPlayers()) do  
				if player.Team and player.Character then  
					local root = player.Character:FindFirstChild("HumanoidRootPart") 
					if root then 
						local enemyFolder = (player.Team == blueTeam) and currentMap.Terminals.PinkTerminals or currentMap.Terminals.BlueTerminals 
						for _, term in ipairs(enemyFolder:GetChildren()) do 
							if (term:IsA("BasePart") or term:IsA("Model")) and not term:IsA("SpawnLocation") then 
								local dist = (root.Position - term.Position).Magnitude 
								local data = playerData[player.UserId] 
								if not data.ProximityHighlights then data.ProximityHighlights = {} end 

								if dist <= PROXIMITY_REVEAL_RANGE then 
									if not data.ProximityHighlights[term] then 
										data.ProximityHighlights[term] = true 
										proximityHighlightGained:FireClient(player, term) 
									end 
								else 
									if data.ProximityHighlights[term] then 
										data.ProximityHighlights[term] = nil 
										proximityHighlightLost:FireClient(player, term) 
									end 
								end 
							end 
						end 
					end  
				end  
			end  
		end  
	end  
end 

