local function handlePlayerDeath(player)  
	if currentGamemode == "TerminalFrenzy" then tf_onHackEnded(player) end 
	if zc_playersInZone[player] then zc_playersInZone[player] = nil end 
	updateTeamRosterEvent:FireAllClients(nil, player.UserId, false)  
	if playerData[player.UserId] then playerData[player.UserId].Deaths += 1 end 
	local respawnTime = BASE_RESPAWN_TIME  
	if player.Team and teamUpgrades[player.Team] then  
		respawnTime = UPGRADE_CONFIG.Respawn.Values[teamUpgrades[player.Team].Respawn + 1] 
	end  
	task.wait(respawnTime)  
	if player then player:LoadCharacter() end 
end  

local function onCharacterAdded(character)  
	local player = Players:GetPlayerFromCharacter(character)  
	if not player then return end  
	local humanoid = character:WaitForChild("Humanoid")  
	humanoid.UseJumpPower = true  
	humanoid.JumpPower = BASE_JUMP_POWER  
	workspace.Gravity = BASE_GRAVITY  
	if player.Team and teamUpgrades[player.Team] then 
		local upgrades = teamUpgrades[player.Team] 
		humanoid.MaxHealth = UPGRADE_CONFIG.Health.Values[upgrades.Health + 1] 
		humanoid.Health = humanoid.MaxHealth 
		humanoid.WalkSpeed = UPGRADE_CONFIG.Speed.Values[upgrades.Speed + 1] 
	end  
	updateTeamRosterEvent:FireAllClients(nil, player.UserId, true)  
	humanoid.Died:Connect(function()  
		local tag = humanoid:FindFirstChild("creator")  
		if tag and tag.Value and tag.Value.UserId ~= player.UserId then 
			local killer = tag.Value  
			local data = playerData[killer.UserId] 
			if data then 
				data.Kills += 1 
				local points = POINTS_PER_KILL 
				data.Points += points 
				updatePointsEvent:FireClient(killer, data.Points) 
			end  
		end  
		handlePlayerDeath(player)  
	end)  
end  

