fireTerminalReveal = function(terminalPart, teamToHackName) 
	local now = os.clock() 
	local lastPing = terminalRevealCooldowns[terminalPart] 
	if lastPing and (now - lastPing < TERMINAL_REVEAL_COOLDOWN) then return end 
	terminalRevealCooldowns[terminalPart] = now 
	revealTerminalEvent:FireAllClients(terminalPart, teamToHackName) 
end 

local function tf_checkHackMilestones(player, progress, teamToHack) 
	local data = tf_playerHackData[player] 
	if not data then return end 

	if progress >= data.nextHackMilestone then 
		data.nextHackMilestone += TF_HACK_MILESTONE_AMOUNT 
		local pData = playerData[player.UserId] 
		if pData then 
			pData.Points += 1 
			updatePointsEvent:FireClient(player, pData.Points) 
		end 
	end  

	if progress >= data.nextRevealMilestone then 
		data.nextRevealMilestone += TF_HACK_MILESTONE_AMOUNT 
		local terminalPart = tf_playersHacking[player] 
		if terminalPart then 
			fireTerminalReveal(terminalPart, teamToHack.Name) 
		end  
	end  
end  

tf_onHackStarted = function(player, terminalPart, teamToHack) 
	local char = player.Character  
	if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return end 

	if player.Team ~= teamToHack then  
		tf_playersHacking[player] = terminalPart  
		local currentProgress = (teamToHack == blueTeam) and tf_blueTeamProgress or tf_pinkTeamProgress  

		tf_playerHackData[player] = {  
			nextHackMilestone = math.floor(currentProgress / TF_HACK_MILESTONE_AMOUNT) * TF_HACK_MILESTONE_AMOUNT + TF_HACK_MILESTONE_AMOUNT,  
			nextRevealMilestone = math.floor(currentProgress / TF_HACK_MILESTONE_AMOUNT) * TF_HACK_MILESTONE_AMOUNT + TF_HACK_MILESTONE_AMOUNT  
		}  
		print(player.Name .. " started hacking " .. teamToHack.Name) 
	end  
end  

tf_onHackEnded = function(player) 
	local terminalPart = tf_playersHacking[player]  
	if terminalPart then  
		local teamToHack = (terminalPart.Parent.Name == "PinkTerminals") and pinkTeam or blueTeam  

		-- Tie-break penalty 
		local myScore = (teamToHack == pinkTeam) and tf_pinkTeamProgress or tf_blueTeamProgress 
		local enemyScore = (teamToHack == pinkTeam) and tf_blueTeamProgress or tf_pinkTeamProgress 

		if getPercent(myScore, TF_TOTAL_HACK_POINTS) == getPercent(enemyScore, TF_TOTAL_HACK_POINTS) then 
			if teamToHack == pinkTeam then 
				tf_pinkTeamProgress = math.max(0, tf_pinkTeamProgress - 1) 
			else 
				tf_blueTeamProgress = math.max(0, tf_blueTeamProgress - 1) 
			end 
		end 

		tf_playersHacking[player] = nil  
		tf_playerHackData[player] = nil  
		tf_updateTerminalHoldDurations(teamToHack)  
		fireTerminalReveal(terminalPart, teamToHack.Name)  
	end  
end  

tf_updateTerminalHoldDurations = function(teamWhoseTerminalsToUpdate)  
	local remainingTime  
	local terminalFolder  

	if teamWhoseTerminalsToUpdate == blueTeam then  
		terminalFolder = currentMap.Terminals.BlueTerminals  
		remainingTime = TF_TOTAL_HACK_POINTS - tf_blueTeamProgress  
	else  
		terminalFolder = currentMap.Terminals.PinkTerminals  
		remainingTime = TF_TOTAL_HACK_POINTS - tf_pinkTeamProgress  
	end  

	for _, terminalPart in ipairs(terminalFolder:GetChildren()) do  
		if (terminalPart:IsA("BasePart") or terminalPart:IsA("Model")) and not terminalPart:IsA("SpawnLocation") then 
			local hackPrompt = terminalPart:FindFirstChildWhichIsA("ProximityPrompt", true) 
			if hackPrompt then 
				hackPrompt.HoldDuration = math.max(0, remainingTime + 1) 
			end  
		end  
	end  
end  

tf_onHeartbeat = function(deltaTime) 
	local isBlueBaseBeingHacked = false 
	local isPinkBaseBeingHacked = false 

	for player, terminalPart in pairs(tf_playersHacking) do 
		if player and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then 
			local teamToHack = terminalPart.Parent.Name == "PinkTerminals" and pinkTeam or blueTeam 

			if teamToHack == blueTeam then 
				tf_blueTeamProgress = math.min(tf_blueTeamProgress + deltaTime, TF_TOTAL_HACK_POINTS) 
				isBlueBaseBeingHacked = true 
				tf_checkHackMilestones(player, tf_blueTeamProgress, blueTeam) 
			elseif teamToHack == pinkTeam then 
				tf_pinkTeamProgress = math.min(tf_pinkTeamProgress + deltaTime, TF_TOTAL_HACK_POINTS) 
				isPinkBaseBeingHacked = true 
				tf_checkHackMilestones(player, tf_pinkTeamProgress, pinkTeam) 
			end 
		else 
			tf_onHackEnded(player) 
		end 
	end 

	local bluePct = getPercent(tf_pinkTeamProgress, TF_TOTAL_HACK_POINTS) 
	local pinkPct = getPercent(tf_blueTeamProgress, TF_TOTAL_HACK_POINTS) 

	if bluePct ~= tf_lastBluePercent or pinkPct ~= tf_lastPinkPercent then 
		updateProgressEvent:FireAllClients(tf_pinkTeamProgress, tf_blueTeamProgress, TF_TOTAL_HACK_POINTS) 
		tf_lastBluePercent = bluePct 
		tf_lastPinkPercent = pinkPct 
	end 

	if currentGameState == "RoundInProgress" then 
		if tf_blueTeamProgress >= TF_TOTAL_HACK_POINTS then 
			setGameState("RoundEnd", pinkTeam) 
		elseif tf_pinkTeamProgress >= TF_TOTAL_HACK_POINTS then 
			setGameState("RoundEnd", blueTeam) 
		end 
	end 

	if isBlueBaseBeingHacked ~= wasBlueBaseAlertSent then 
		updateHackAlertEvent:FireAllClients(blueTeam.TeamColor, pinkTeam.TeamColor, isBlueBaseBeingHacked) 
		wasBlueBaseAlertSent = isBlueBaseBeingHacked 
	end 
	if isPinkBaseBeingHacked ~= wasPinkBaseAlertSent then 
		updateHackAlertEvent:FireAllClients(pinkTeam.TeamColor, blueTeam.TeamColor, isPinkBaseBeingHacked) 
		wasPinkBaseAlertSent = isPinkBaseBeingHacked 
	end 

	if not mapEventTriggered then 
		if (tf_pinkTeamProgress / TF_TOTAL_HACK_POINTS) >= DYNAMIC_MAP_THRESHOLD or 
			(tf_blueTeamProgress / TF_TOTAL_HACK_POINTS) >= DYNAMIC_MAP_THRESHOLD then 
			mapEventTriggered = true 
			triggerDynamicMapEvents() 
		end 
	end 
end 

