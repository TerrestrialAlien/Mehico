onUpgradeTriggered = function(player, team) 
	if player.Team == team then 
		showUpgradeGuiEvent:FireClient(player) 
	end 
end 

local function onRequestUpgrade(player, upgradeType) 
	local data = playerData[player.UserId] 
	local team = player.Team 
	if not data or not team then return end 

	local currentLvl = teamUpgrades[team][upgradeType] 
	local config = UPGRADE_CONFIG[upgradeType] 

	if currentLvl >= config.MaxLevel then return end 

	local cost = config.Costs[currentLvl + 1] 
	if data.Points >= cost then 
		data.Points -= cost 
		teamUpgrades[team][upgradeType] += 1 
		local newLvl = teamUpgrades[team][upgradeType] 

		print(player.Name .. " bought " .. upgradeType .. " Lvl " .. newLvl) 
		updatePointsEvent:FireClient(player, data.Points) 
		updateUpgradeLevelsEvent:FireAllClients(team, upgradeType, newLvl) 

		if player.Character then 
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid") 
			if humanoid then 
				if upgradeType == "Health" then 
					humanoid.MaxHealth = config.Values[newLvl + 1] 
					humanoid.Health = humanoid.MaxHealth 
				elseif upgradeType == "Speed" then 
					humanoid.WalkSpeed = config.Values[newLvl + 1] 
				end 
			end 
		end 
	end  
end  

