calculateZonePenalty = function(startStats, currentScore, currentPenalty) 
	local startRem = (ZC_TARGET_POINTS - startStats.score) + (startStats.penalty or 0) 
	local endRem = (ZC_TARGET_POINTS - currentScore) + (currentPenalty or 0) 

	if startStats.score < (startStats.opponentScore or 0) and currentScore >= (startStats.opponentScore or 0) then 
		endRem = (ZC_TARGET_POINTS - startStats.opponentScore) + (currentPenalty or 0) 
	end 

	local delta = startRem - endRem 
	if delta <= 0 then return 0 end 

	local penalty = math.floor((0.75 * delta) + 0.5) 
	if math.abs(startRem - ZC_TARGET_POINTS) < 1e-6 then 
		penalty = penalty + 1 
	end 
	return penalty 
end 

resetZoneEffect = function(player)  
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")  
	if not humanoid then return end 

	local healthLvl = teamUpgrades[player.Team] and teamUpgrades[player.Team].Health or 0 
	local speedLvl = teamUpgrades[player.Team] and teamUpgrades[player.Team].Speed or 0 

	local baseHealth = UPGRADE_CONFIG.Health.Values[healthLvl + 1]  
	local baseSpeed = UPGRADE_CONFIG.Speed.Values[speedLvl + 1]  

	humanoid.UseJumpPower = true  
	humanoid.MaxHealth = baseHealth  
	humanoid.WalkSpeed = baseSpeed  
	humanoid.JumpPower = BASE_JUMP_POWER  
	workspace.Gravity = BASE_GRAVITY  

	if humanoid.Health > baseHealth then humanoid.Health = baseHealth end 
end  

applyZoneEffect = function(player)  
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")  
	if not humanoid or humanoid.Health <= 0 then return end  

	resetZoneEffect(player) -- Reset first 
	if not zc_currentEffect then return end 

	if zc_currentEffect == "Speed Boost" then  
		humanoid.WalkSpeed = 40  
	elseif zc_currentEffect == "Low Health" then  
		humanoid.MaxHealth = 75  
		if humanoid.Health > 75 then humanoid.Health = 75 end 
	elseif zc_currentEffect == "High Jump" then  
		humanoid.JumpPower = BASE_JUMP_POWER * 2.5  
	elseif zc_currentEffect == "Low Gravity" then  
		workspace.Gravity = BASE_GRAVITY * 0.35  
		humanoid.JumpPower = BASE_JUMP_POWER * 1.5  
	end  
end  

zc_onHeartbeat = function(deltaTime) 
	local blueHasBoth = (zc_pole1Owner == blueTeam and zc_pole2Owner == blueTeam) 
	local pinkHasBoth = (zc_pole1Owner == pinkTeam and zc_pole2Owner == pinkTeam) 

	if blueHasBoth then  
		if zc_bluePenalty > 0 then 
			zc_bluePenalty = math.max(0, zc_bluePenalty - (deltaTime * 2)) 
		else 
			zc_blueProgress = math.min(ZC_TARGET_POINTS, zc_blueProgress + deltaTime)  
		end 
	end  
	if pinkHasBoth then  
		if zc_pinkPenalty > 0 then 
			zc_pinkPenalty = math.max(0, zc_pinkPenalty - (deltaTime * 2)) 
		else 
			zc_pinkProgress = math.min(ZC_TARGET_POINTS, zc_pinkProgress + deltaTime)  
		end 
	end  

	local bluePct = getPercent(zc_blueProgress, ZC_TARGET_POINTS)  
	local pinkPct = getPercent(zc_pinkProgress, ZC_TARGET_POINTS)  
	if bluePct ~= zc_lastBluePercent or pinkPct ~= zc_lastPinkPercent then 
		updateZoneCountdown:FireAllClients(zc_blueProgress, zc_pinkProgress, ZC_TARGET_POINTS, math.ceil(zc_bluePenalty), math.ceil(zc_pinkPenalty))  
		zc_lastBluePercent = bluePct  
		zc_lastPinkPercent = pinkPct  
	end 

	if currentGameState == "RoundInProgress" then 
		if zc_blueProgress >= ZC_TARGET_POINTS then setGameState("RoundEnd", blueTeam) 
		elseif zc_pinkProgress >= ZC_TARGET_POINTS then setGameState("RoundEnd", pinkTeam) end 
	end 

	if not mapEventTriggered then  
		if (zc_blueProgress / ZC_TARGET_POINTS) >= DYNAMIC_MAP_THRESHOLD or 
			(zc_pinkProgress / ZC_TARGET_POINTS) >= DYNAMIC_MAP_THRESHOLD then 
			mapEventTriggered = true  
			triggerDynamicMapEvents()  
		end  
	end  

	if zc_zone then  
		zc_zoneCheckTimer = zc_zoneCheckTimer + deltaTime 
		if zc_zoneCheckTimer >= ZC_ZONE_CHECK_INTERVAL then 
			zc_zoneCheckTimer = 0 

			local playersInZoneNow = {} 
			local partsInZone = workspace:GetPartsInPart(zc_zone) 

			for _, part in ipairs(partsInZone) do 
				local player = Players:GetPlayerFromCharacter(part.Parent) 
				if player and not playersInZoneNow[player] then 
					playersInZoneNow[player] = true 
					if not zc_playersInZone[player] then 
						zc_playersInZone[player] = true 
						applyZoneEffect(player) 
					end 
				end  
			end  

			for player, _ in pairs(zc_playersInZone) do 
				if not playersInZoneNow[player] then 
					zc_playersInZone[player] = nil 
					resetZoneEffect(player) 
				end 
			end  
		end 
	end  

	if zc_currentEffect == "Burning Ground" then  
		zc_damageTimer = zc_damageTimer + deltaTime  
		if zc_damageTimer >= ZC_DAMAGE_TICK then  
			zc_damageTimer = 0  
			for player, _ in pairs(zc_playersInZone) do  
				if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then  
					player.Character.Humanoid:TakeDamage(ZC_DAMAGE_AMOUNT)  
				end  
			end  
		end  
	end  
end  

zc_onPoleCaptured = function(player, poleNumber)  
	if not player.Team then return end  
	local team = player.Team  
	local prevBlueHasBoth = (zc_pole1Owner == blueTeam and zc_pole2Owner == blueTeam) 
	local prevPinkHasBoth = (zc_pole1Owner == pinkTeam and zc_pole2Owner == pinkTeam) 

	if poleNumber == 1 then  
		if zc_pole1Owner == team then return end 
		zc_pole1Owner = team  
	elseif poleNumber == 2 then  
		if zc_pole2Owner == team then return end 
		zc_pole2Owner = team  
	end  

	local newBlueHasBoth = (zc_pole1Owner == blueTeam and zc_pole2Owner == blueTeam) 
	local newPinkHasBoth = (zc_pole1Owner == pinkTeam and zc_pole2Owner == pinkTeam) 
	local alertType = "OnePole" 
	local justGotBoth = false 

	if newBlueHasBoth and not prevBlueHasBoth then 
		justGotBoth = true 
		alertType = "BothPoles" 
		if zc_lastZoneOwner == "Pink" then 
			local penalty = calculateZonePenalty(zc_pinkStartStats, zc_pinkProgress, zc_pinkPenalty) 
			if penalty > 0 then zc_pinkPenalty += penalty end 
		end 
		zc_lastZoneOwner = "Blue" 
		zc_blueStartStats = { score = zc_blueProgress, penalty = zc_bluePenalty, opponentScore = zc_pinkProgress } 
	end 

	if newPinkHasBoth and not prevPinkHasBoth then 
		justGotBoth = true 
		alertType = "BothPoles" 
		if zc_lastZoneOwner == "Blue" then 
			local penalty = calculateZonePenalty(zc_blueStartStats, zc_blueProgress, zc_bluePenalty) 
			if penalty > 0 then zc_bluePenalty += penalty end 
		end 
		zc_lastZoneOwner = "Pink" 
		zc_pinkStartStats = { score = zc_pinkProgress, penalty = zc_pinkPenalty, opponentScore = zc_blueProgress } 
	end 

	updateZoneControlUI:FireAllClients(zc_pole1, zc_pole1Owner, zc_pole2, zc_pole2Owner)  
	zoneAlertEvent:FireAllClients(alertType, team)  

	if justGotBoth then  
		zc_currentEffect = ZC_EFFECTS_LIST[math.random(1, #ZC_EFFECTS_LIST)]  
		print("ZONE ACTIVATED! Effect: " .. zc_currentEffect) 
		updateZoneEffect:FireAllClients(zc_currentEffect)  

		if zc_currentEffect == "Fog" and zc_fogEmitter then 
			print("Enabling Fog Emitter") 
			zc_fogEmitter.Enabled = true 
		end 

		for p, _ in pairs(zc_playersInZone) do applyZoneEffect(p) end 
	elseif zc_pole1Owner ~= zc_pole2Owner and zc_currentEffect then 

		if zc_fogEmitter then  
			print("Disabling Fog Emitter") 
			zc_fogEmitter.Enabled = false  
		end 

		zc_currentEffect = nil 
		updateZoneEffect:FireAllClients(nil) 
		for p, _ in pairs(zc_playersInZone) do resetZoneEffect(p) end 
	end  
end  

