Players.PlayerAdded:Connect(function(player) 
	playerData[player.UserId] = { Team = nil, Points = 0, Kills = 0, Deaths = 0, PassiveTimer = 0, ProximityHighlights = {} } 
	player.CharacterAdded:Connect(onCharacterAdded)  
	if currentGameState == "RoundInProgress" then  
		local bCount = #blueTeam:GetPlayers() 
		local pCount = #pinkTeam:GetPlayers() 
		player.Team = (bCount <= pCount) and blueTeam or pinkTeam 
		playerData[player.UserId].Team = player.Team 
		giveLoadout(player)  
		player:LoadCharacter()  
	end  
	local rosters = { [blueTeam.Name] = {}, [pinkTeam.Name] = {} } 
	for _, p in ipairs(Players:GetPlayers()) do  
		if p.Team then table.insert(rosters[p.Team.Name], {Name = p.Name, UserId = p.UserId}) end 
	end  
	local bProg, pProg, maxProg = tf_pinkTeamProgress, tf_blueTeamProgress, TF_TOTAL_HACK_POINTS 
	if currentGamemode == "ZoneControl" then  
		bProg, pProg, maxProg = zc_blueProgress, zc_pinkProgress, ZC_TARGET_POINTS 
	end  
	playerSyncEvent:FireClient(player, currentGameState, 
		(currentGameState == "Intermission" and intermissionTimer or roundTimer), 
		currentStatus, bProg, pProg, maxProg, rosters, playerData[player.UserId].Points, currentGamemode) 
end) 

Players.PlayerRemoving:Connect(function(player) 
	if zc_playersInZone[player] then zc_playersInZone[player] = nil end 
	if currentGamemode == "TerminalFrenzy" then tf_onHackEnded(player) end 
	playerData[player.UserId] = nil 

	local rosters = { [blueTeam.Name] = {}, [pinkTeam.Name] = {} } 
	for _, p in ipairs(Players:GetPlayers()) do  
		if p ~= player and p.Team then table.insert(rosters[p.Team.Name], {Name = p.Name, UserId = p.UserId}) end 
	end  
	updateTeamRosterEvent:FireAllClients(rosters)  
	if currentGameState == "RoundInProgress" then  
		if #blueTeam:GetPlayers() == 0 or #pinkTeam:GetPlayers() == 0 then 
			currentStatus = "Round ended - team was empty."  
			updateGameStateEvent:FireAllClients("RoundEnd", currentStatus)  
			task.delay(3, function() setGameState("Intermission") end) 
		end  
	end  
end) 

