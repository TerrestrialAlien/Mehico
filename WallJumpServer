--[[
	WallJumpServer.lua (v2.3 - Service Access Fix)
	- Validates wall jump AND wall boost requests.
	- Checks distance to prevent flying.
	- Checks TEAM tags on Jump Pads to prevent hacking.
	- FIX: Reverted to game:GetService("ReplicatedStorage") which is the correct method for Server Scripts.
]]

-- --- SERVICES ---
local ReplicatedStorage = game:GetService("ReplicatedStorage") -- *** THIS IS THE FIX ***
local CollectionService = game:GetService("CollectionService")
local Teams = game:GetService("Teams")

-- --- EVENTS ---
local eventFolder = ReplicatedStorage:WaitForChild("GameEvents")
local requestWallJumpEvent = eventFolder:WaitForChild("RequestWallJump")
local requestWallBoostEvent = eventFolder:WaitForChild("RequestWallBoost")

-- --- TEAMS ---
local blueTeam = Teams["Bright blue"]
local pinkTeam = Teams["Carnation pink"]

-- --- CONSTANTS ---
local MAX_WALL_DISTANCE = 12 -- Studs (Leeway for lag)
local WALL_JUMP_TAG = "WallJump"
local WALL_BOOST_TAG = "WallBoost"
local PAD_TAG_BLUE = "JumpPad_Blue"
local PAD_TAG_PINK = "JumpPad_Pink"

-- ===================================================================
-- HANDLERS
-- ===================================================================

local function onWallJumpRequest(player, wallPosition)
	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	-- Distance Check
	local dist = (root.Position - wallPosition).Magnitude
	if dist > MAX_WALL_DISTANCE then return end

	-- Tag Check
	local overlapParams = OverlapParams.new()
	overlapParams.FilterDescendantsInstances = {char}
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude

	local parts = workspace:GetPartBoundsInRadius(wallPosition, 6, overlapParams)
	local foundWall = false

	for _, part in ipairs(parts) do
		if CollectionService:HasTag(part, WALL_JUMP_TAG) then
			foundWall = true
			break
		end
	end

	if not foundWall then
		warn("Possible cheat: " .. player.Name .. " tried to wall jump off invalid part.")
	end
end

-- Boost & Jump Pad Validation
local function onWallBoostRequest(player, wallPosition)
	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	-- Distance Check
	local dist = (root.Position - wallPosition).Magnitude
	if dist > MAX_WALL_DISTANCE then 
		warn("Possible cheat: " .. player.Name .. " tried to boost from too far away.")
		return 
	end

	-- Check for Valid Tags AND Teams
	local overlapParams = OverlapParams.new()
	overlapParams.FilterDescendantsInstances = {char}
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude

	local parts = workspace:GetPartBoundsInRadius(wallPosition, 6, overlapParams)
	local isValid = false

	for _, part in ipairs(parts) do
		-- 1. Normal Wall Boost (Anyone can use)
		if CollectionService:HasTag(part, WALL_BOOST_TAG) then
			isValid = true
			break
		end

		-- 2. Blue Jump Pad (Only Blue Team)
		if CollectionService:HasTag(part, PAD_TAG_BLUE) then
			if player.Team == blueTeam then
				isValid = true
				break
			else
				warn("Cheat Attempt: " .. player.Name .. " tried to use Blue Pad but is not on Blue Team!")
			end
		end

		-- 3. Pink Jump Pad (Only Pink Team)
		if CollectionService:HasTag(part, PAD_TAG_PINK) then
			if player.Team == pinkTeam then
				isValid = true
				break
			else
				warn("Cheat Attempt: " .. player.Name .. " tried to use Pink Pad but is not on Pink Team!")
			end
		end
	end

	if not isValid then
		-- Optional: Punishment logic here
		warn("Boost Validation Failed for " .. player.Name)
	end
end

-- ===================================================================
-- INIT
-- ===================================================================

requestWallJumpEvent.OnServerEvent:Connect(onWallJumpRequest)
requestWallBoostEvent.OnServerEvent:Connect(onWallBoostRequest)

print("WallJumpServer (v2.3 - Service Access Fix) Loaded")
