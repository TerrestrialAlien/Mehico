-- Called when a hack alert is fired (Terminal Frenzy)
local function onHackAlert(hackedTeamColor, hackerTeamColor, isBeingHacked)
	-- Increment the alert id so only the latest scheduled reset runs
	currentAlertId = currentAlertId + 1
	local myId = currentAlertId
	activeAlert = true

	-- Find the team objects by comparing their colors
	local hackedTeam = (hackedTeamColor == blueTeam.TeamColor) and blueTeam or pinkTeam
	local hackerTeam = (hackerTeamColor == blueTeam.TeamColor) and blueTeam or pinkTeam

	if isBeingHacked then
		-- HACKING STARTED
		print("HACKING STARTED alert received")
		StatusLabel.Text = hackedTeam.Name .. "'s terminal is being hacked!"
		StatusLabel.TextColor3 = hackerTeam.TeamColor.Color

		-- Play sound (if not already playing)
		if not HackAlertSound.Playing then
			HackAlertSound:Play()
		end

		-- Start wobble animation
		if hackerTeam == blueTeam and not blueHackThread then
			blueHackThread = task.spawn(function()
				while true do
					BluePercentLabel.Rotation = 10
					task.wait(HACK_WOBBLE_TIME)
					BluePercentLabel.Rotation = -10
					task.wait(HACK_WOBBLE_TIME)
				end
			end)
		elseif hackerTeam == pinkTeam and not pinkHackThread then
			pinkHackThread = task.spawn(function()
				while true do
					PinkPercentLabel.Rotation = 10
					task.wait(HACK_WOBBLE_TIME)
					PinkPercentLabel.Rotation = -10
					task.wait(HACK_WOBBLE_TIME)
				end
			end)
		end

	else
		-- HACKING STOPPED
		print("HACKING STOPPED alert received")
		StatusLabel.Text = hackedTeam.Name .. "'s terminal has stopped being hacked!"
		StatusLabel.TextColor3 = hackedTeam.TeamColor.Color

		-- Play sound (if not already playing)
		if not HackStopSound.Playing then
			HackStopSound:Play()
		end

		-- Stop wobble animation
		if hackedTeam == pinkTeam and blueHackThread then
			task.cancel(blueHackThread)
			blueHackThread = nil
			TweenService:Create(BluePercentLabel, HACK_TWEEN_INFO_RESET, {Rotation = -2}):Play()
		elseif hackedTeam == blueTeam and pinkHackThread then
			task.cancel(pinkHackThread)
			pinkHackThread = nil
			TweenService:Create(PinkPercentLabel, HACK_TWEEN_INFO_RESET, {Rotation = 2}):Play()
		end
	end

	-- Schedule a reset 3 seconds later. Only perform reset if this is still the latest alert.
	task.delay(3, function()
		if myId == currentAlertId then
			StatusLabel.Text = defaultStatusText
			StatusLabel.TextColor3 = Color3.new(1, 1, 1)
			activeAlert = false
		end
	end)
end

-- NEW: Called when a zone alert is fired (Zone Control)
local function onZoneAlert(alertType, team)
	currentAlertId = currentAlertId + 1
	local myId = currentAlertId
	activeAlert = true

	if alertType == "OnePole" then
		StatusLabel.Text = team.Name .. " captured a pole!"
		if not ZoneAlertOnePoleSound.Playing then
			ZoneAlertOnePoleSound:Play()
		end
	elseif alertType == "BothPoles" then
		StatusLabel.Text = team.Name .. " captured both poles and controls the zone!"
		if not ZoneAlertBothPolesSound.Playing then
			ZoneAlertBothPolesSound:Play()
		end
	end

	StatusLabel.TextColor3 = team.TeamColor.Color

	-- Reset after 3 seconds
	task.delay(3, function()
		if myId == currentAlertId then
			StatusLabel.Text = defaultStatusText
			StatusLabel.TextColor3 = Color3.new(1, 1, 1)
			activeAlert = false
		end
	end)
end

-- Called when a player joins, leaves, or dies
local function onUpdateTeamRoster(rosters, targetUserId, isAlive)

	-- This is a "status update" (death/respawn) not a full roster change
	if targetUserId then
		local avatar = playerAvatarCache[targetUserId]
		if avatar then
			-- Gray out if dead, restore color if alive
			avatar.ImageColor3 = isAlive and Color3.new(1, 1, 1) or Color3.new(0.3, 0.3, 0.3)
		end
		return -- Stop here
	end

	-- This is a FULL roster update
	-- Clear all old avatars
	BlueAvatarContainer:ClearAllChildren()
	PinkAvatarContainer:ClearAllChildren()
	playerAvatarCache = {}

	if not rosters then
		print("Roster cleared (Intermission)")
		return
	end

	-- Create avatars for Blue Team
	if rosters[blueTeam.Name] then
		for _, playerObj in ipairs(rosters[blueTeam.Name]) do
			local avatar = PlayerAvatarTemplate:Clone()
			avatar.Name = playerObj.Name
			avatar.Visible = true
			avatar.Parent = BlueAvatarContainer

			-- Store in cache
			playerAvatarCache[playerObj.UserId] = avatar

			-- Fetch and apply thumbnail (in a protected call)
			local success, content, isReady = pcall(Players.GetUserThumbnailAsync, Players, playerObj.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
			if success and isReady then
				avatar.Image = content
			else
				warn("Could not load thumbnail for " .. playerObj.Name)
			end
		end
	end

	-- Create avatars for Pink Team
	if rosters[pinkTeam.Name] then
		for _, playerObj in ipairs(rosters[pinkTeam.Name]) do
			local avatar = PlayerAvatarTemplate:Clone()
			avatar.Name = playerObj.Name
			avatar.Visible = true
			avatar.Parent = PinkAvatarContainer

			-- Store in cache
			playerAvatarCache[playerObj.UserId] = avatar

			-- Fetch and apply thumbnail (in a protected call)
			local success, content, isReady = pcall(Players.GetUserThumbnailAsync, Players, playerObj.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
			if success and isReady then
				avatar.Image = content
			else
				warn("Could not load thumbnail for " .. playerObj.Name)
			end
		end
	end
end

-- Called when the dynamic map event is fired
local function onMapAlert()
	print("Map alert received!")
	activeAlert = true
	currentAlertId = currentAlertId + 1
	local myId = currentAlertId

	StatusLabel.Text = "Last push, the map is changing!"
	StatusLabel.TextColor3 = Color3.fromRGB(255, 170, 0) -- Orange

	-- Play sound (if not already playing)
	if not MapChangeSound.Playing then
		MapChangeSound:Play()
	end

	-- Wait for the alarm to finish
	task.wait(MapChangeSound.TimeLength)

	-- Play rumble
	if not MapRumbleSound.Playing then
		MapRumbleSound:Play()
	end

	-- Reset text after 7 seconds (4s warning + 3s text)
	task.delay(7, function()
		if myId == currentAlertId then
			StatusLabel.Text = defaultStatusText
			StatusLabel.TextColor3 = Color3.new(1, 1, 1)
			activeAlert = false
		end
	end)
end

-- Called when a terminal should be revealed
local function onRevealTerminal(terminalPart, hackedTeamName)
	if not terminalPart or not terminalPart.Parent then return end

	print("Revealing terminal: " .. terminalPart.Name)

	local highlight = Instance.new("Highlight")

	-- Check if *my* team is the one being hacked
	if player.Team and player.Team.Name == hackedTeamName then
		-- I am a DEFENDER
		print("I am on the defending team, showing RED highlight.")
		highlight.FillColor = Color3.fromRGB(255, 0, 0)
		highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
	else
		-- I am an ATTACKER
		print("I am on the attacking team, showing WHITE highlight.")
		highlight.FillColor = Color3.fromRGB(255, 255, 255)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	end

	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- See through walls
	highlight.FillTransparency = 0.8
	highlight.OutlineTransparency = 0.2

	-- FIX: Parent to GUI and Adorn to the part!
	highlight.Adornee = terminalPart
	highlight.Parent = GameGui

	-- Destroy after 5 seconds
	task.delay(5, function()
		if highlight and highlight.Parent then
			highlight:Destroy()
		end
	end)
end

-- Called when we get close to an enemy terminal
local function onProximityGained(terminalPart)
	if not terminalPart or not terminalPart.Parent then return end
	if proximityHighlights[terminalPart] then return end -- Already showing

	print("Proximity gained for: " .. terminalPart.Name)

	local highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.fromRGB(255, 170, 0) -- Orange
	highlight.OutlineColor = Color3.fromRGB(255, 170, 0)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = 0.8
	highlight.OutlineTransparency = 0.2

	-- FIX: Parent to GUI and Adorn to the part!
	highlight.Adornee = terminalPart
	highlight.Parent = GameGui

	proximityHighlights[terminalPart] = highlight
end

-- Called when we move away from an enemy terminal
local function onProximityLost(terminalPart)
	if not terminalPart or not proximityHighlights[terminalPart] then return end

	print("Proximity lost for: " .. terminalPart.Name)
	proximityHighlights[terminalPart]:Destroy()
	proximityHighlights[terminalPart] = nil
end

-- Called when player points are updated
local function onUpdatePoints(points)
