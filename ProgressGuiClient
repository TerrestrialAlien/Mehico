-- ===================================================================
-- Utility / Tweening Helpers
-- ===================================================================

local function safeCancelTween(tween)
	if tween then
		-- There's no Cancel on Tween objects; we can stop by: tween:Cancel() (Roblox supports Cancel)
		pcall(function() tween:Cancel() end)
	end
end

-- Tween the progress bar size smoothly
local function tweenProgressBar(targetGuiObject, targetFraction, duration)
	-- targetGuiObject is the "Progress" frame whose Size should be tweened
	-- targetFraction is 0..1
	local targetUDim = UDim2.new(math.clamp(targetFraction, 0, 1), 0, 1, 0)
	-- Cancel existing tween if present
	-- For safety, create a new tween
	local ti = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TweenService:Create(targetGuiObject, ti, {Size = targetUDim})
	tween:Play()
	return tween
end

-- Numeric tween helper (interpolates numbers and calls updateFunc(value) each step)
local function tweenNumber(fromValue, toValue, duration, updateFunc)
	-- Cancel by returning a token; for simplicity we'll spawn a task that updates.
	-- We'll use a simple lerp with task.wait() frame stepping.
	local start = tick()
	local finish = start + duration
	local cancelled = false
	local co = task.spawn(function()
		while true do
			local now = tick()
			local alpha = 1
			if finish > start then
				alpha = math.clamp((now - start) / duration, 0, 1)
			end
			local value = fromValue + (toValue - fromValue) * alpha
			updateFunc(value)
			if alpha >= 1 then break end
			task.wait() -- yield one frame
		end
	end)
	-- We don't return a cancellable object here; future calls will just overwrite the visual values.
	return co
end

-- Formats percent string with optional penalty
local function formatPercentText(percentVal, penalty)
	-- percentVal: number 0..100
	-- penalty: integer >=0
	local base = string.format("%.0f%%", percentVal)
	if penalty and penalty > 0 then
		return base .. " (+" .. tostring(penalty) .. ")"
	end
	return base
end

-- Helper to set percent label BG frame color (with quick tween for smoothness)
local function setPercentFrameColor(frame, color)
	-- Tween BackgroundColor3 for a bit of smoothness
	local ti = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(frame, ti, { BackgroundColor3 = color }):Play()
end

