	end
end

-- Called every time the timer changes
local function onUpdateTimer(seconds)
	local minutes = math.floor(seconds / 60)
	local remainingSeconds = seconds % 60
	TimerLabel.Text = string.format("%d:%02d", minutes, remainingSeconds)
end

-- Called when the game state changes (e.g., "Intermission")
local function onUpdateGameState(state, status)
	-- Store the state locally
	currentGameState = state

	-- Set the default text for the *next* round
	if state == "Intermission" then
		defaultStatusText = "Waiting for players..."
	elseif currentGamemode == "ZoneControl" then
		defaultStatusText = "Capture the Towers!"
	else
		defaultStatusText = "Hack the enemy terminal!"
	end

	-- *** THIS IS THE FIX ***
	-- If this is a special state (like RoundEnd), display the server's message directly
	if state == "RoundEnd" then
		activeAlert = false -- Stop any alerts
		StatusLabel.Text = status -- Show "Round Over! [Team] wins!"
		StatusLabel.TextColor3 = Color3.new(1, 1, 1)

	elseif not activeAlert then
		-- If it's not RoundEnd and there's no alert, show the default text
		StatusLabel.Text = defaultStatusText
		StatusLabel.TextColor3 = Color3.new(1, 1, 1)
	end

	-- Reset tweens and highlights on intermission
	if state == "Intermission" then
		if blueHackThread then
			task.cancel(blueHackThread)
			blueHackThread = nil
			TweenService:Create(BluePercentLabel, HACK_TWEEN_INFO_RESET, {Rotation = -2}):Play()
		end
		if pinkHackThread then
			task.cancel(pinkHackThread)
			pinkHackThread = nil
			TweenService:Create(PinkPercentLabel, HACK_TWEEN_INFO_RESET, {Rotation = 2}):Play()
		end

		-- Clear all highlights
		for _, highlight in pairs(proximityHighlights) do
			highlight:Destroy()
		end
		proximityHighlights = {}

		for _, child in ipairs(GameGui:GetChildren()) do
			if child:IsA("Highlight") then
				child:Destroy()
			end
		end

		-- Reset percent frames to default color
		setPercentFrameColor(BluePercentFrame, DEFAULT_PERCENT_FRAME_COLOR)
		setPercentFrameColor(PinkPercentFrame, DEFAULT_PERCENT_FRAME_COLOR)
	end
end

-- Listener for hack progress changes (TerminalFrenzy) - tween the bars too
local function onUpdateProgress(blueProg, pinkProg, maxProg)
	-- Server now sends (Blue_Score, Pink_Score, Max)
	-- We receive as (blueProg, pinkProg, maxProg)

	local blueFraction = 0
	if maxProg > 0 then
		blueFraction = blueProg / maxProg
	end

	local pinkFraction = 0
	if maxProg > 0 then
		pinkFraction = pinkProg / maxProg
	end

	-- Tween bars
	if activeBlueBarTween then safeCancelTween(activeBlueBarTween) end
	activeBlueBarTween = tweenProgressBar(BlueProgress, blueFraction, BAR_TWEEN_DURATION)

	if activePinkBarTween then safeCancelTween(activePinkBarTween) end
	activePinkBarTween = tweenProgressBar(PinkProgress, pinkFraction, BAR_TWEEN_DURATION)

	-- Numeric tween for percent labels (no penalty in TF mode)
	local oldBluePerc = displayedBluePercentValue
	local newBluePerc = (blueFraction * 100)
	tweenNumber(oldBluePerc, newBluePerc, NUMBER_TWEEN_DURATION, function(val)
		displayedBluePercentValue = val
		BluePercentLabel.Text = formatPercentText(val, 0)
	end)

	local oldPinkPerc = displayedPinkPercentValue
	local newPinkPerc = (pinkFraction * 100)
	tweenNumber(oldPinkPerc, newPinkPerc, NUMBER_TWEEN_DURATION, function(val)
		displayedPinkPercentValue = val
		PinkPercentLabel.Text = formatPercentText(val, 0)
	end)

	-- Store displayed fractions for internal state
	displayedBlueFraction = blueFraction
	displayedPinkFraction = pinkFraction
end

-- NEW: Listener for Zone Control countdown
-- Accepts optional penalty args: updateZoneCountdown:FireAllClients(zc_blueProgress, zc_pinkProgress, ZC_TARGET_POINTS, ceil(bluePenalty), ceil(pinkPenalty))
local function onUpdateZoneCountdown(blueProg, pinkProg, maxProg, bluePenalty, pinkPenalty)
	-- default penalty values if server didn't send them
	bluePenalty = bluePenalty or 0
	pinkPenalty = pinkPenalty or 0

	-- Server sends (Blue_Progress, Pink_Progress, Max)
	local blueFraction = 0
	if maxProg > 0 then
		blueFraction = blueProg / maxProg
	end

	local pinkFraction = 0
	if maxProg > 0 then
		pinkFraction = pinkProg / maxProg
	end

	-- Tween bars
	if activeBlueBarTween then safeCancelTween(activeBlueBarTween) end
	activeBlueBarTween = tweenProgressBar(BlueProgress, blueFraction, BAR_TWEEN_DURATION)

	if activePinkBarTween then safeCancelTween(activePinkBarTween) end
	activePinkBarTween = tweenProgressBar(PinkProgress, pinkFraction, BAR_TWEEN_DURATION)

	-- Numeric tween for percent labels, include penalty inside text when >0
	local oldBluePerc = displayedBluePercentValue
	local newBluePerc = (blueFraction * 100)
	tweenNumber(oldBluePerc, newBluePerc, NUMBER_TWEEN_DURATION, function(val)
		displayedBluePercentValue = val
		BluePercentLabel.Text = formatPercentText(val, bluePenalty)
	end)

	local oldPinkPerc = displayedPinkPercentValue
	local newPinkPerc = (pinkFraction * 100)
	tweenNumber(oldPinkPerc, newPinkPerc, NUMBER_TWEEN_DURATION, function(val)
		displayedPinkPercentValue = val
		PinkPercentLabel.Text = formatPercentText(val, pinkPenalty)
	end)

	-- Store displayed fractions for internal state
	displayedBlueFraction = blueFraction
	displayedPinkFraction = pinkFraction
end

-- NEW: Listener for Zone Control pole UI
local function onUpdateZoneUI(pole1, pole1Owner, pole2, pole2Owner)
	-- Color the Pole Icons
	if pole1Owner == blueTeam then
		PoleIcon1.BackgroundColor3 = blueTeam.TeamColor.Color
	elseif pole1Owner == pinkTeam then
		PoleIcon1.BackgroundColor3 = pinkTeam.TeamColor.Color
	else
		PoleIcon1.BackgroundColor3 = Color3.new(45/255, 45/255, 45/255) -- dark gray
	end

	if pole2Owner == blueTeam then
		PoleIcon2.BackgroundColor3 = blueTeam.TeamColor.Color
	elseif pole2Owner == pinkTeam then
		PoleIcon2.BackgroundColor3 = pinkTeam.TeamColor.Color
	else
		PoleIcon2.BackgroundColor3 = Color3.new(45/255, 45/255, 45/255) -- dark gray
	end

	-- Color the Glow Parts in the map
	if pole1 and pole1:FindFirstChild("GlowPart") then
		pole1.GlowPart.BrickColor = pole1Owner and pole1Owner.TeamColor or BrickColor.new("White")
	end
	if pole2 and pole2:FindFirstChild("GlowPart") then
		pole2.GlowPart.BrickColor = pole2Owner and pole2Owner.TeamColor or BrickColor.new("White")
	end

	-- *** THIS IS THE FIX ***
	-- Check who is scoring and apply/stop wobble

	-- Check Blue Team wobble
	if pole1Owner == blueTeam and pole2Owner == blueTeam then
		-- Blue is scoring, start wobble
		if not blueHackThread then
			blueHackThread = task.spawn(function()
				while true do
					BluePercentLabel.Rotation = 10
					task.wait(HACK_WOBBLE_TIME)
					BluePercentLabel.Rotation = -10
					task.wait(HACK_WOBBLE_TIME)
				end
			end)
		end
	else
		-- Blue is NOT scoring, stop wobble
		if blueHackThread then
			task.cancel(blueHackThread)
			blueHackThread = nil
			TweenService:Create(BluePercentLabel, HACK_TWEEN_INFO_RESET, {Rotation = -2}):Play()
		end
	end

	-- Check Pink Team wobble
	if pole1Owner == pinkTeam and pole2Owner == pinkTeam then
		-- Pink is scoring, start wobble
		if not pinkHackThread then
			pinkHackThread = task.spawn(function()
				while true do
					PinkPercentLabel.Rotation = 10
					task.wait(HACK_WOBBLE_TIME)
					PinkPercentLabel.Rotation = -10
					task.wait(HACK_WOBBLE_TIME)
				end
			end)
		end
	else
		-- Pink is NOT scoring, stop wobble
		if pinkHackThread then
			task.cancel(pinkHackThread)
			pinkHackThread = nil
			TweenService:Create(PinkPercentLabel, HACK_TWEEN_INFO_RESET, {Rotation = 2}):Play()
		end
	end

	-- --- NEW: Change percent label frame background when a team controls BOTH poles ---
	-- If blue has both, tint blue percent frame to blue color and reset pink's; if pink has both do vice versa; otherwise reset both to default color
	local blueHasBoth = (pole1Owner == blueTeam and pole2Owner == blueTeam)
	local pinkHasBoth = (pole1Owner == pinkTeam and pole2Owner == pinkTeam)

	if blueHasBoth then
		setPercentFrameColor(BluePercentFrame, blueTeam.TeamColor.Color)
		setPercentFrameColor(PinkPercentFrame, DEFAULT_PERCENT_FRAME_COLOR)
	elseif pinkHasBoth then
		setPercentFrameColor(PinkPercentFrame, pinkTeam.TeamColor.Color)
		setPercentFrameColor(BluePercentFrame, DEFAULT_PERCENT_FRAME_COLOR)
	else
		-- neither controls both: reset both
		setPercentFrameColor(BluePercentFrame, DEFAULT_PERCENT_FRAME_COLOR)
		setPercentFrameColor(PinkPercentFrame, DEFAULT_PERCENT_FRAME_COLOR)
	end
end

-- NEW: Main listener for gamemode
local function onUpdateGameMode(gamemode)
	currentGamemode = gamemode

	if gamemode == "TerminalFrenzy" then
		-- Show/Hide UI elements
		BlueAvatarContainer.Visible = true
		PinkAvatarContainer.Visible = true
		PoleIcon1.Visible = false
		PoleIcon2.Visible = false

		-- Set default text
		defaultStatusText = "Hack the enemy terminal!"

		-- Re-connect the right event
		tfProgressConnection = updateProgressEvent.OnClientEvent:Connect(onUpdateProgress)
		-- Disconnect the other
		if zcCountdownConnection then zcCountdownConnection:Disconnect() zcCountdownConnection = nil end

	elseif gamemode == "ZoneControl" then
		-- Show/Hide UI elements
		BlueAvatarContainer.Visible = false
		PinkAvatarContainer.Visible = false
		PoleIcon1.Visible = true
		PoleIcon2.Visible = true

		-- Set default text
		defaultStatusText = "Capture the Towers!"

		-- Re-connect the right event
		zcCountdownConnection = updateZoneCountdown.OnClientEvent:Connect(onUpdateZoneCountdown)
		-- Disconnect the other
		if tfProgressConnection then tfProgressConnection:Disconnect() tfProgressConnection = nil end

	elseif gamemode == "Intermission" then
		-- Hide everything
		BlueAvatarContainer.Visible = false
		PinkAvatarContainer.Visible = false
		PoleIcon1.Visible = false
		PoleIcon2.Visible = false
		defaultStatusText = "Waiting for players..."

		-- Disconnect both
		if zcCountdownConnection then zcCountdownConnection:Disconnect() zcCountdownConnection = nil end
		if tfProgressConnection then tfProgressConnection:Disconnect() tfProgressConnection = nil end
	end

	-- Set status label to default
	StatusLabel.Text = defaultStatusText
end


-- Called ONCE when this client first joins
local function onPlayerSync(state, timer, status, blueProg, pinkProg, maxProg, rosters, points, gamemode)
	print("Receiving sync packet from server...")

	-- Store state locally
	currentGameState = state

	-- Set initial state
	onUpdateGameMode(gamemode or "Intermission") -- This sets the defaultStatusText
	StatusLabel.Text = defaultStatusText
	StatusLabel.TextColor3 = Color3.new(1, 1, 1)
	activeAlert = false
	currentAlertId = 0

	-- Sync all values
	onUpdateTimer(timer)
	onUpdatePoints(points)

	-- Sync progress based on gamemode
	if currentGamemode == "TerminalFrenzy" then
		onUpdateProgress(blueProg, pinkProg, maxProg)
	elseif currentGamemode == "ZoneControl" then
		-- server may not include penalty args in initial sync; pass defaults
		onUpdateZoneCountdown(blueProg, pinkProg, maxProg, 0, 0)
	end


	-- Update roster (wrapped in pcall to prevent sync from crashing)
	local success, err = pcall(onUpdateTeamRoster, rosters)
	if not success then
		warn("Error during initial player sync: " .. tostring(err))
	end
end

